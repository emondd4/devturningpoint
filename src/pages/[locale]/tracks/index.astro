---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tracks } from '../../../data/tracks/tracks';
import { trackIcon } from '../../../data/navigation';
import { localePath, type Locale, isLocale, locales } from '../../../i18n/config';
import MaterialIcon from '../../../components/ui/MaterialIcon.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
---

<BaseLayout
  locale={locale}
  title={isBn ? 'লার্নিং ট্র্যাক' : 'Learning tracks'}
  description={isBn ? 'Prerequisite-first ক্যারিয়ার লার্নিং ট্র্যাক।' : 'Prerequisite-first career learning tracks.'}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <p class="section-eyebrow">{isBn ? 'শেখা' : 'Learn'}</p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-[length:var(--font-size-h1)] font-semibold text-[var(--color-text)]">
      {isBn ? 'লার্নিং ট্র্যাক' : 'Learning tracks'}
    </h1>
    <p class="mt-3 max-w-2xl text-[var(--color-text-secondary)]">
      {
        isBn
          ? 'প্রতিটি ট্র্যাকে assessment ও ব্যক্তিগত রোডম্যাপ আছে। উন্নত টপিকের আগে প্রয়োজনীয় ভিত্তি দেখানো হয়।'
          : 'Each track includes an assessment and a personalized roadmap. Advanced topics show required foundations first.'
      }
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        tracks.map((track) => (
          <a
            href={localePath(locale, `tracks/${track.slug}`)}
            class="surface-card group block no-underline"
          >
            <div class="flex items-start gap-3">
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[color-mix(in_srgb,var(--color-primary)_12%,transparent)] text-[var(--color-primary)]">
                <MaterialIcon name={trackIcon(track.id)} size={24} />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <h2 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-primary)]">
                    {isBn ? track.titleBn : track.title}
                  </h2>
                  <span class="badge">{track.priority}</span>
                </div>
                <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
                  {isBn ? track.summaryBn : track.summary}
                </p>
                <p class="mt-3 text-xs text-[var(--color-text-muted)]">{track.primaryStack.join(' · ')}</p>
                <p class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)]">
                  {isBn ? 'ট্র্যাক খুলুন' : 'Open track'}
                  <MaterialIcon name="arrow_forward" size={16} />
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
