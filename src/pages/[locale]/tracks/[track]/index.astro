---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getTrack, tracks } from '../../../../data/tracks/tracks';
import { localePath, type Locale, isLocale } from '../../../../i18n/config';
import { masterGraph } from '../../../../data/skill-graphs/master-graph';
import { suggestLearningOrder, getDirectPrerequisites } from '../../../../utils/graph';
import SkillGraphView from '../../../../components/graph/SkillGraphView';
import ContinueLearningCard from '../../../../components/progress/ContinueLearningCard';

export function getStaticPaths() {
  const locales = ['en', 'bn'] as const;
  return locales.flatMap((locale) =>
    tracks.map((track) => ({
      params: { locale, track: track.slug },
      props: { trackId: track.id },
    })),
  );
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const track = getTrack(Astro.params.track ?? '');
if (!track) {
  return Astro.redirect(localePath(locale, 'tracks'));
}

const isBn = locale === 'bn';
const trackNodes = masterGraph.nodes.filter((n) => n.track === track.id || track.goalSkillIds.includes(n.id));
const ordered = suggestLearningOrder(
  masterGraph,
  trackNodes.map((n) => n.id),
);
---

<BaseLayout
  locale={locale}
  title={isBn ? track.titleBn : track.title}
  description={isBn ? track.summaryBn : track.summary}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <nav class="mb-4 text-sm text-[var(--color-ink-subtle)]" aria-label="Breadcrumb">
      <a href={localePath(locale)} class="no-underline">{isBn ? 'হোম' : 'Home'}</a>
      <span aria-hidden="true"> / </span>
      <a href={localePath(locale, 'tracks')} class="no-underline">{isBn ? 'ট্র্যাক' : 'Tracks'}</a>
      <span aria-hidden="true"> / </span>
      <span>{isBn ? track.titleBn : track.title}</span>
    </nav>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold text-[var(--color-ink)]">
          {isBn ? track.titleBn : track.title}
        </h1>
        <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">{isBn ? track.summaryBn : track.summary}</p>
      </div>
      <a class="btn btn-primary" href={localePath(locale, `tracks/${track.slug}/assessment`)}>
        {isBn ? 'Assessment শুরু করুন' : 'Start assessment'}
      </a>
    </div>

    <div class="mt-6">
      <ContinueLearningCard client:load locale={locale} trackId={track.id} trackSlug={track.slug} />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-[var(--color-ink)]">{isBn ? 'স্কিল গ্রাফ' : 'Skill graph'}</h2>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
        {isBn ? 'ভিজ্যুয়াল গ্রাফের পাশাপাশি accessible তালিকাও আছে।' : 'Visual graph plus an accessible ordered list.'}
      </p>
      <div class="mt-4">
        <SkillGraphView
          client:load
          locale={locale}
          nodes={trackNodes}
          edges={masterGraph.edges.filter(
            (e) => trackNodes.some((n) => n.id === e.from) && (trackNodes.some((n) => n.id === e.to) || e.type === 'belongsToTrack'),
          )}
        />
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-[var(--color-ink)]">{isBn ? 'প্রস্তাবিত ক্রম' : 'Suggested order'}</h2>
      <ol class="mt-4 space-y-2">
        {
          ordered.map((id, index) => {
            const node = masterGraph.nodes.find((n) => n.id === id);
            const prereqs = getDirectPrerequisites(masterGraph, id);
            return (
              <li class="surface-card">
                <div class="flex flex-wrap items-baseline gap-2">
                  <span class="text-sm text-[var(--color-ink-subtle)]">{index + 1}.</span>
                  <a class="font-medium no-underline" href={localePath(locale, `learn/${id.toLowerCase().replace(/_/g, '-')}`)}>
                    {node?.title ?? id}
                  </a>
                  {node?.difficulty && <span class="badge">{node.difficulty}</span>}
                </div>
                {prereqs.length > 0 && (
                  <p class="mt-1 text-xs text-[var(--color-ink-subtle)]">
                    {isBn ? 'প্রয়োজন' : 'Requires'}: {prereqs.join(', ')}
                  </p>
                )}
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</BaseLayout>
