---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ComputingBlueprint from '../../../components/history/ComputingBlueprint.astro';
import { locales, type Locale, isLocale, localePath } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
---

<BaseLayout
  locale={locale}
  title={isBn ? 'কম্পিউটার ইঞ্জিনিয়ারিং ব্লুপ্রিন্ট' : 'Computer engineering blueprint'}
  description={isBn ? 'হার্ডওয়্যার থেকে প্রোডাক্ট পর্যন্ত ক্ষেত্রগুলোর সম্পর্ক।' : 'How computing domains relate from hardware to product.'}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold">
      {isBn ? 'কম্পিউটার ইঞ্জিনিয়ারিং ব্লুপ্রিন্ট' : 'Computer engineering blueprint'}
    </h1>
    <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">
      {
        isBn
          ? 'এটি একটি মানসিক মানচিত্র—প্রতিটি বাক্স একটি লার্নিং ট্র্যাক বা ক্যারিয়ার এলাকায় গভীর হয়।'
          : 'A mental map—each area deepens into learning tracks and careers.'
      }
    </p>
    <div class="mt-8">
      <ComputingBlueprint locale={locale} />
    </div>
    <p class="mt-8">
      <a class="btn btn-primary" href={localePath(locale, 'tracks')}>{isBn ? 'ট্র্যাক দেখুন' : 'Browse tracks'}</a>
      <a class="btn btn-secondary ml-2" href={localePath(locale, 'history')}>{isBn ? 'ইতিহাস' : 'History'}</a>
    </p>
  </div>
</BaseLayout>
