---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const title = isBn ? 'সম্পাদনা পদ্ধতি' : 'Editorial methodology';
const body = isBn ? 'আমরা অফিসিয়াল ডকুমেন্টেশন ও প্রাথমিক সূত্র (S1–S2) অগ্রাধিকার দিই। সময়-সংবেদনশীল দাবিতে lastVerified থাকে। পরিসংখ্যান বানিয়ে বলি না।' : 'We prefer official documentation and primary sources (S1–S2). Time-sensitive claims show lastVerified dates. We do not fabricate statistics.';
---

<BaseLayout locale={locale} title={title} description={body}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 prose-reading">
    <h1>{title}</h1>
    <p>{body}</p>
  </div>
</BaseLayout>
