---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const interviews = await getCollection('interviews');
---

<BaseLayout locale={locale} title={isBn ? 'ইন্টারভিউ ব্যাংক' : 'Interview bank'} description="Career and technology interview questions with depth by level.">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold">{isBn ? 'ইন্টারভিউ ব্যাংক' : 'Interview bank'}</h1>
    <p class="mt-3 text-[var(--color-ink-muted)]">
      {isBn ? 'গভীরতা অগ্রাধিকার—তুচ্ছ “X কী?” প্রশ্ন নয়।' : 'Depth over trivia—junior through senior/lead framing.'}
    </p>
    <div class="mt-8 space-y-4">
      {
        interviews.map((item) => (
          <article class="surface-card">
            <p class="badge">{item.data.difficulty}</p>
            <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)]">{item.data.question}</h2>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]"><strong>Short:</strong> {item.data.shortAnswer}</p>
            <details class="mt-2 text-sm text-[var(--color-ink-muted)]">
              <summary class="cursor-pointer font-medium text-[var(--color-ink)]">{isBn ? 'শক্তিশালী উত্তর' : 'Strong answer'}</summary>
              <p class="mt-2">{item.data.strongAnswer}</p>
              {item.data.advancedAnswer && <p class="mt-2"><strong>Advanced:</strong> {item.data.advancedAnswer}</p>}
            </details>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
