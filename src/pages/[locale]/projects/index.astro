---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const projects = await getCollection('projects');
---

<BaseLayout locale={locale} title={isBn ? 'প্রজেক্ট' : 'Projects'} description="Portfolio-oriented practice projects by track.">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold">{isBn ? 'প্রজেক্ট-ভিত্তিক শেখা' : 'Project-based learning'}</h1>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        projects.map((project) => (
          <article class="surface-card">
            <p class="badge">{project.data.difficulty}</p>
            <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)]">
              {isBn && project.data.titleBn ? project.data.titleBn : project.data.title}
            </h2>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]">{project.data.summary}</p>
            <p class="mt-3 text-xs text-[var(--color-ink-subtle)]">{project.data.track}</p>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]"><strong>{isBn ? 'পোর্টফোলিওতে প্রমাণ' : 'Portfolio proof'}:</strong> {project.data.portfolioProof}</p>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
