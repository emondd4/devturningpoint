---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isLocale, localePath } from '../../../i18n/config';
import { getTrack } from '../../../data/tracks/tracks';
import { learnPathForId } from '../../../utils/topic-links';
import { buildCursorPrompt, promptButtonLabel } from '../../../utils/project-prompt';
import { levelLabel } from '../../../data/projects/catalog';
import CopyCursorPrompt from '../../../components/projects/CopyCursorPrompt';
import ProjectProgressPanel from '../../../components/projects/ProjectProgressPanel';
import sources from '../../../data/source-registry/sources.json';
import { getInterviewQuestions } from '../../../data/interviews';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return locales.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale, slug: project.data.slug },
      props: { project },
    })),
  );
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const { project } = Astro.props;
const { Content } = await render(project);
const track = getTrack(project.data.track);
const prompt = buildCursorPrompt(project.data);
const projectSources = sources.filter((s) => project.data.sources.includes(s.id));

const allProjects = await getCollection('projects');
const byId = new Map(allProjects.map((p) => [p.data.id, p]));
const prev = project.data.previousProjectId ? byId.get(project.data.previousProjectId) : undefined;
const next = project.data.nextProjectId ? byId.get(project.data.nextProjectId) : undefined;

const bank = getInterviewQuestions(project.data.track);
const bankById = new Map(bank.map((q) => [q.id, q.question]));
const deepDives = await getCollection('interviews');
const diveById = new Map(deepDives.map((d) => [d.data.id, d.data.question]));
const interviewQuestions = project.data.relatedInterviewQuestionIds
  .map((id) => ({
    id,
    question: bankById.get(id) ?? diveById.get(id) ?? id,
  }))
  .slice(0, 15);

const milestoneViews = project.data.milestones.map((m) => ({
  id: m.id,
  title: m.title,
  objective: m.objective,
  whyItMatters: m.whyItMatters,
  tasks: m.tasks,
  validationChecklist: m.validationChecklist,
  commonProblems: m.commonProblems,
  expectedArtifacts: m.expectedArtifacts,
  completionCriteria: m.completionCriteria,
}));
---

<BaseLayout
  locale={locale}
  title={project.data.title}
  description={project.data.summary}
  ogType="article"
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6" data-pagefind-body>
    <nav class="mb-4 text-sm text-[var(--color-ink-subtle)] no-print" aria-label="Breadcrumb">
      <a href={localePath(locale)} class="no-underline">{isBn ? 'হোম' : 'Home'}</a>
      <span> / </span>
      <a href={localePath(locale, 'projects')} class="no-underline">{isBn ? 'প্রজেক্ট' : 'Projects'}</a>
      <span> / </span>
      <span>{project.data.title}</span>
    </nav>

    <header class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-subtle)]">{project.data.id}</p>
      <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold text-[var(--color-ink)]">
        {project.data.title}
      </h1>
      <p class="mt-3 text-[var(--color-ink-muted)]">{project.data.summary}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="badge">{levelLabel(project.data.level, isBn)}</span>
        <span class="badge">{track ? (isBn ? track.titleBn : track.title) : project.data.track}</span>
        <span class="badge">{project.data.estimatedHours}h</span>
      </div>
      <p class="mt-4 text-sm text-[var(--color-ink-muted)]">
        <strong>{isBn ? 'পোর্টফোলিও পিচ' : 'Portfolio pitch'}:</strong> {project.data.portfolioPitch}
      </p>
      <div class="mt-4 flex flex-wrap gap-2 no-print">
        <CopyCursorPrompt
          client:load
          prompt={prompt}
          label={promptButtonLabel(project.data.track, isBn)}
          copiedLabel={isBn ? 'কপি হয়েছে' : 'Copied'}
        />
        {
          track && (
            <a class="btn" href={localePath(locale, `tracks/${track.slug}`)}>
              {isBn ? 'ট্র্যাকে ফিরে যান' : 'Back to track'}
            </a>
          )
        }
      </div>
    </header>

    <section class="mb-10">
      <h2 class="text-xl font-semibold text-[var(--color-ink)]">{isBn ? 'পূর্বশর্ত স্কিল' : 'Prerequisite skills'}</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--color-ink-muted)]">
        {
          project.data.prerequisiteSkillIds.map((id) => {
            const href = learnPathForId(locale, id);
            return <li>{href ? <a href={href}>{id}</a> : id}</li>;
          })
        }
      </ul>
      <h3 class="mt-6 text-lg font-semibold text-[var(--color-ink)]">
        {isBn ? 'শেখার ফলাফল স্কিল' : 'Learning outcome skills'}
      </h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[var(--color-ink-muted)]">
        {project.data.learningOutcomeSkillIds.map((id) => <li>{id}</li>)}
      </ul>
      <h3 class="mt-6 text-lg font-semibold text-[var(--color-ink)]">{isBn ? 'সম্পর্কিত টপিক' : 'Related topics'}</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[var(--color-ink-muted)]">
        {
          project.data.relatedTopicIds.map((id) => {
            const href = learnPathForId(locale, id);
            return <li>{href ? <a href={href}>{id}</a> : id}</li>;
          })
        }
      </ul>
      <h3 class="mt-6 text-lg font-semibold text-[var(--color-ink)]">{isBn ? 'প্রস্তাবিত টুল' : 'Recommended tools'}</h3>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">{project.data.recommendedTools.join(' · ')}</p>
    </section>

    <div class="mb-10">
      <ProjectProgressPanel
        client:load
        locale={locale}
        projectId={project.data.id}
        milestones={milestoneViews}
        interviewQuestions={interviewQuestions}
      />
    </div>

    <article class="prose-reading topic-content mb-10">
      <Content />
    </article>

    <section class="mb-10 surface-card">
      <h2 class="text-xl font-semibold text-[var(--color-ink)]">
        {isBn ? 'পোর্টফোলিও প্রমাণ চেকলিস্ট' : 'Portfolio evidence checklist'}
      </h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--color-ink-muted)]">
        {project.data.portfolioEvidence.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {
      projectSources.length > 0 && (
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-[var(--color-ink)]">{isBn ? 'সূত্র' : 'Sources'}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {projectSources.map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer" target="_blank">
                  {source.title}
                </a>
                <span class="text-[var(--color-ink-subtle)]">
                  {' '}
                  · {source.authorityTier} · accessed {source.accessedDate}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="flex flex-wrap justify-between gap-4 border-t border-[var(--color-border)] pt-6 text-sm">
      {
        prev ? (
          <a href={localePath(locale, `projects/${prev.data.slug}`)}>
            ← {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={localePath(locale, `projects/${next.data.slug}`)}>
            {next.data.title} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</BaseLayout>
