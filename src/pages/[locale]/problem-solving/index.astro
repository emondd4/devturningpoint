---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProblemBankBrowser from '../../../components/problem-solving/ProblemBankBrowser';
import { locales, type Locale, isLocale } from '../../../i18n/config';
import { getAllProblems, problemCatalog } from '../../../data/problem-solving';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';

const problems = getAllProblems();
const categories = problemCatalog.categories.map((c) => c.label);

const title = isBn ? 'সমস্যা সমাধান' : 'Problem Solving';
const description = isBn
  ? `${problemCatalog.totalProblems}টি ক্লাসিক ইন্টারভিউ সমস্যা—ধাপে ধাপে পদ্ধতি, সমাধান, এবং টাইম/স্পেস জটিলতাসহ।`
  : `${problemCatalog.totalProblems} classic coding interview problems, each with a step-by-step approach, a worked solution, and time/space complexity.`;
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <header class="max-w-3xl">
      <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-ink-subtle)]">
        {isBn ? 'সমস্যা সমাধান' : 'Problem Solving'}
      </p>
      <h1 class="mt-1 font-[family-name:var(--font-display)] text-3xl font-semibold text-[var(--color-ink)]">
        {title}
      </h1>
      <p class="mt-3 text-[var(--color-ink-muted)]">
        {description}
      </p>
      <p class="mt-2 text-sm text-[var(--color-ink-subtle)]">
        {
          isBn
            ? 'ডেটা স্ট্রাকচার ও অ্যালগরিদম বেসিক ঝালাই করতে চান? আগে ফাউন্ডেশন ট্র্যাকের কমপ্লেক্সিটি টপিকগুলো দেখুন।'
            : 'Need to refresh data structure/algorithm basics first? See the complexity topics in the Foundations track.'
        }
      </p>
    </header>

    <div class="mt-8">
      <ProblemBankBrowser client:load locale={locale} problems={problems} categories={categories} />
    </div>
  </div>
</BaseLayout>
