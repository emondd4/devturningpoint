---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { locales, type Locale, isLocale, localePath } from '../../../../i18n/config';
import decisionGuides from '../../../../data/ai/decision-guides.json';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const guides = decisionGuides as Array<{
  id: string;
  title: string;
  problem: string;
  criteria: string[];
  tradeOffs: string;
  complexity: string;
  lockIn: string;
  security: string;
  cost: string;
  exampleScenarios: string[];
  references: string[];
  lastVerified: string;
}>;
---

<BaseLayout
  locale={locale}
  title={isBn ? 'AI framework সিদ্ধান্ত গাইড' : 'AI framework decision guides'}
  description="Criteria-based comparisons for AI tools and architectures."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6" data-pagefind-body>
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold text-[var(--color-ink)]">
      {isBn ? 'Framework / tool সিদ্ধান্ত গাইড' : 'Framework & tool decision guides'}
    </h1>
    <p class="mt-3 text-[var(--color-ink-muted)]">
      {
        isBn
          ? 'জনপ্রিয়তা র‍্যাঙ্কিং নয়—সমস্যা, criteria, trade-off।'
          : 'Not popularity rankings—problem, criteria, and trade-offs.'
      }
    </p>

    <ul class="mt-8 space-y-6">
      {
        guides.map((g) => (
          <li class="surface-card" id={g.id}>
            <h2 class="text-lg font-semibold text-[var(--color-ink)]">{g.title}</h2>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
              <strong>{isBn ? 'সমস্যা' : 'Problem'}:</strong> {g.problem}
            </p>
            <p class="mt-2 text-sm">
              <strong>{isBn ? 'Criteria' : 'Criteria'}:</strong> {g.criteria.join('; ')}
            </p>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
              <strong>{isBn ? 'Trade-offs' : 'Trade-offs'}:</strong> {g.tradeOffs}
            </p>
            <ul class="mt-2 space-y-1 text-sm text-[var(--color-ink-muted)]">
              <li>
                <strong>{isBn ? 'জটিলতা' : 'Complexity'}:</strong> {g.complexity}
              </li>
              <li>
                <strong>{isBn ? 'Lock-in' : 'Lock-in'}:</strong> {g.lockIn}
              </li>
              <li>
                <strong>{isBn ? 'নিরাপত্তা' : 'Security'}:</strong> {g.security}
              </li>
              <li>
                <strong>{isBn ? 'খরচ' : 'Cost'}:</strong> {g.cost}
              </li>
            </ul>
            <p class="mt-2 text-sm">
              <strong>{isBn ? 'উদাহরণ' : 'Example scenarios'}:</strong>
            </p>
            <ul class="mt-1 list-disc pl-5 text-sm text-[var(--color-ink-muted)]">
              {g.exampleScenarios.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <p class="mt-2 text-xs text-[var(--color-ink-subtle)]">
              refs: {g.references.join(', ')} · verified {g.lastVerified}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-sm">
      <a href={localePath(locale, 'ai')}>{isBn ? 'AI hub' : 'AI hub'}</a>
      {' · '}
      <a href={localePath(locale, 'ai/tools')}>{isBn ? 'টুল' : 'Tools'}</a>
    </p>
  </div>
</BaseLayout>
