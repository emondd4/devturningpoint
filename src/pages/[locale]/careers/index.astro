---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePath, locales, type Locale, isLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const careers = (await getCollection('careers')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  locale={locale}
  title={isBn ? 'ক্যারিয়ার ডিরেক্টরি' : 'Career directory'}
  description={isBn ? 'বাংলাদেশ-প্রাসঙ্গিক প্রযুক্তি ক্যারিয়ার।' : 'Technology careers relevant to Bangladesh.'}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <h1 class="font-[family-name:var(--font-display)] text-3xl font-semibold">{isBn ? 'ক্যারিয়ার ডিরেক্টরি' : 'Career directory'}</h1>
    <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">
      {
        isBn
          ? 'রোল নামগুলো overlapping title normalize করা হয়েছে। বাংলাদেশ মার্কেট নোট সূত্রসহ—বেতন অনুমান নয়।'
          : 'Overlapping titles are normalized. Bangladesh notes are sourced—no fabricated salary ranges.'
      }
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        careers.map((career) => (
          <a href={localePath(locale, `careers/${career.data.slug}`)} class="surface-card block no-underline hover:border-[var(--color-accent)]">
            <h2 class="text-lg font-semibold text-[var(--color-ink)]">{isBn && career.data.nameBn ? career.data.nameBn : career.data.name}</h2>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]">{isBn && career.data.summaryBn ? career.data.summaryBn : career.data.summary}</p>
            <p class="mt-3 text-xs text-[var(--color-ink-subtle)]">
              {isBn ? 'যাচাই' : 'Verified'}: {career.data.lastVerified}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
