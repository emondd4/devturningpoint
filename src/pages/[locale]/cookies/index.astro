---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const isBn = locale === 'bn';
const title = isBn ? 'কুকি ও ট্র্যাকিং' : 'Cookies & tracking';
const body = isBn ? 'মূল লার্নিং বিজ্ঞাপন কুকি ছাড়াই কাজ করে। পরে analytics/AdSense চালু হলে এই পেজ আপডেট করা উচিত।' : 'Core learning works without advertising cookies. If analytics or AdSense are enabled later via environment configuration, this page should be updated to describe those cookies.';
---

<BaseLayout locale={locale} title={title} description={body}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 prose-reading">
    <h1>{title}</h1>
    <p>{body}</p>
  </div>
</BaseLayout>
