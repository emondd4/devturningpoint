---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n/ui';
import { localePath, type Locale, isLocale, withBase } from '../i18n/config';
import { siteConfig } from '../config/site';
import MaterialIcon from '../components/ui/MaterialIcon.astro';

const localeParam = Astro.url.pathname.includes('/bn/') ? 'bn' : 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const t = getDictionary(locale);
const isBn = locale === 'bn';
---

<BaseLayout locale={locale} title={t.notFound.title} description={t.notFound.body} noindex>
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <img
      src={withBase(siteConfig.brand.icon)}
      alt=""
      width={72}
      height={72}
      class="mx-auto h-16 w-16 object-contain"
      decoding="async"
    />
    <p class="mt-6 text-sm font-semibold text-[var(--color-primary)]">404</p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold text-[var(--color-text)]">
      {t.notFound.title}
    </h1>
    <p class="mt-3 text-[var(--color-text-secondary)]">{t.notFound.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href={localePath(locale)}>
        <MaterialIcon name="home" size={18} />
        {isBn ? 'হোম' : 'Go Home'}
      </a>
      <a class="btn btn-secondary" href={localePath(locale, 'search')}>
        <MaterialIcon name="search" size={18} />
        {t.nav.search}
      </a>
      <a class="btn btn-ghost" href={localePath(locale, 'tracks')}>
        <MaterialIcon name="school" size={18} />
        {isBn ? 'লার্নিং ট্র্যাক' : 'Explore Learning Tracks'}
      </a>
    </div>
  </div>
</BaseLayout>
