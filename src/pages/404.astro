---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n/ui';
import { localePath, type Locale, isLocale } from '../i18n/config';

const localeParam = Astro.url.pathname.includes('/bn/') ? 'bn' : 'en';
const locale: Locale = isLocale(localeParam) ? localeParam : 'en';
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.notFound.title} description={t.notFound.body} noindex>
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-semibold text-[var(--color-accent)]">404</p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold">{t.notFound.title}</h1>
    <p class="mt-3 text-[var(--color-ink-muted)]">{t.notFound.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href={localePath(locale)}>{locale === 'bn' ? 'হোম' : 'Home'}</a>
      <a class="btn btn-secondary" href={localePath(locale, 'search')}>{t.nav.search}</a>
      <a class="btn btn-ghost" href={localePath(locale, 'careers')}>{t.nav.careers}</a>
      <a class="btn btn-ghost" href={localePath(locale, 'tracks')}>{t.nav.roadmaps}</a>
    </div>
  </div>
</BaseLayout>
