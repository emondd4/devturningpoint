---
import type { Locale } from '../../i18n/config';
import { getDictionary } from '../../i18n/ui';
import { localePath } from '../../i18n/config';
import { getFooterColumns, labelFor } from '../../data/navigation';
import { siteConfig } from '../../config/site';
import BrandLogo from '../brand/BrandLogo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
const isBn = locale === 'bn';
const columns = getFooterColumns(locale);
const description = isBn ? siteConfig.shortDescriptionBn : siteConfig.shortDescription;
---

<footer class="no-print mt-16 border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_2fr]">
      <div>
        <a href={localePath(locale)} class="inline-block no-underline" aria-label={t.siteName}>
          <BrandLogo variant="wordmark" height={40} />
        </a>
        <p class="mt-4 max-w-md text-sm text-[var(--color-text-secondary)]">{description}</p>
        <p class="mt-3 text-sm text-[var(--color-text-muted)]">{t.progress.localOnly}</p>
        <a
          class="btn btn-secondary btn-sm mt-5"
          href={siteConfig.repoUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          {t.footer.openSource}
        </a>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          columns.map((column) => (
            <div>
              <p class="text-sm font-semibold text-[var(--color-text)]">
                {isBn ? column.titleBn : column.titleEn}
              </p>
              <ul class="mt-3 space-y-2 text-sm">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-primary)]"
                      {...(link.href.startsWith('http')
                        ? { rel: 'noopener noreferrer', target: '_blank' }
                        : {})}
                    >
                      {labelFor(link, locale)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--color-border)] pt-5 text-xs text-[var(--color-text-muted)]">
      <p>
        © {year} {t.siteName}. Code MIT · Educational content CC BY 4.0.
      </p>
      <p>
        {
          isBn
            ? 'বাংলাদেশের শিক্ষার্থীদের জন্য নির্মিত—সর্বত্র উপযোগী।'
            : 'Built for learners in Bangladesh, useful everywhere.'
        }
      </p>
      <div class="flex gap-3">
        <a href={localePath('en')} class="no-underline hover:text-[var(--color-primary)]">English</a>
        <a href={localePath('bn')} class="no-underline hover:text-[var(--color-primary)]">বাংলা</a>
      </div>
    </div>
  </div>
</footer>
