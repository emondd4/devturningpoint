---
import type { Locale } from '../../i18n/config';
import { getDictionary } from '../../i18n/ui';
import { localePath, withBase } from '../../i18n/config';
import { getPrimaryNav, labelFor } from '../../data/navigation';
import { siteConfig } from '../../config/site';
import ThemeToggle from '../common/ThemeToggle';
import LanguageSwitcher from '../common/LanguageSwitcher';
import MobileNav from './MobileNav';
import BrandLogo from '../brand/BrandLogo.astro';
import MaterialIcon from '../ui/MaterialIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const primary = getPrimaryNav(locale);
const currentPath = Astro.url.pathname;
const isBn = locale === 'bn';

function isActive(href: string): boolean {
  if (!href) return false;
  const normalized = href.replace(/\/$/, '');
  const path = currentPath.replace(/\/$/, '');
  if (normalized.endsWith(`/${locale}`) || normalized.endsWith(`/${locale}/`)) {
    return path.endsWith(`/${locale}`);
  }
  return path === normalized || path.startsWith(`${normalized}/`);
}
---

<header class="site-header no-print" data-site-header>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
    <a href={localePath(locale)} class="group flex min-w-0 items-center no-underline" aria-label={t.siteName}>
      <span class="hidden sm:block">
        <BrandLogo variant="wordmark" height={36} />
      </span>
      <span class="sm:hidden">
        <BrandLogo variant="icon" height={34} />
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Primary">
      {
        primary.map((item) =>
          item.children && item.children.length > 0 && item.id === 'learn' ? (
            <div class="relative group/nav">
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
                aria-haspopup="true"
              >
                {labelFor(item, locale)}
                <MaterialIcon name="expand_more" size={18} />
              </a>
              <div
                class="invisible absolute left-0 top-full z-50 min-w-[18rem] translate-y-1 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-2 opacity-0 shadow-[var(--shadow-md)] transition group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100 group-focus-within/nav:visible group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100"
                role="menu"
              >
                <div class="grid max-h-[70vh] gap-0.5 overflow-y-auto">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="nav-link w-full justify-start"
                      role="menuitem"
                      aria-current={isActive(child.href) ? 'page' : undefined}
                    >
                      {child.icon && <MaterialIcon name={child.icon} size={18} />}
                      <span>{labelFor(child, locale)}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="nav-link"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {labelFor(item, locale)}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-1">
      <LanguageSwitcher
        client:load
        locale={locale}
        labels={{ en: t.language.en, bn: t.language.bn, label: t.language.label }}
      />
      <ThemeToggle
        client:load
        labels={{ light: t.theme.light, dark: t.theme.dark, system: t.theme.system, label: t.theme.label }}
      />
      <a
        href={localePath(locale, 'my-learning')}
        class="btn btn-ghost btn-icon hidden md:inline-flex"
        aria-label={t.nav.myLearning}
        title={t.nav.myLearning}
      >
        <MaterialIcon name="progress_activity" size={22} />
      </a>
      <MobileNav
        client:load
        locale={locale}
        siteName={t.siteName}
        logoSrc={withBase(siteConfig.brand.icon)}
        menuLabel={isBn ? 'মেনু' : 'Menu'}
        closeLabel={isBn ? 'বন্ধ' : 'Close'}
      />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
