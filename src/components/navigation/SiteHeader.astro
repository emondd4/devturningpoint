---
import type { Locale } from '../../i18n/config';
import { getDictionary } from '../../i18n/ui';
import { localePath } from '../../i18n/config';
import ThemeToggle from '../common/ThemeToggle';
import LanguageSwitcher from '../common/LanguageSwitcher';
import MobileNav from './MobileNav';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const links = [
  { href: localePath(locale, 'tracks'), label: t.nav.roadmaps },
  { href: localePath(locale, 'careers'), label: t.nav.careers },
  { href: localePath(locale, 'companies'), label: t.nav.companies },
  { href: localePath(locale, 'history'), label: t.nav.history },
  { href: localePath(locale, 'interviews'), label: t.nav.interviews },
  { href: localePath(locale, 'projects'), label: t.nav.projects },
  { href: localePath(locale, 'search'), label: t.nav.search },
  { href: localePath(locale, 'my-learning'), label: t.nav.myLearning },
];
---

<header class="no-print sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-surface-1)_92%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={localePath(locale)} class="group flex min-w-0 items-center gap-2 no-underline">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-accent)] text-sm font-bold text-white"
        aria-hidden="true">DT</span
      >
      <span class="truncate font-[family-name:var(--font-display)] text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">
        {t.siteName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-[var(--radius-md)] px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink-muted)] no-underline hover:bg-[var(--color-surface-2)] hover:text-[var(--color-ink)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher client:load locale={locale} labels={{ en: t.language.en, bn: t.language.bn, label: t.language.label }} />
      <ThemeToggle
        client:load
        labels={{ light: t.theme.light, dark: t.theme.dark, system: t.theme.system, label: t.theme.label }}
      />
      <MobileNav
        client:load
        locale={locale}
        siteName={t.siteName}
        links={links}
        menuLabel={locale === 'bn' ? 'মেনু' : 'Menu'}
        closeLabel={locale === 'bn' ? 'বন্ধ' : 'Close'}
      />
    </div>
  </div>
</header>
